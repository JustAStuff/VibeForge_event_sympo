VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only variables (NOT prefixed with VITE_ — do not expose to frontend)
# These go in Vercel environment variables or Supabase Edge Function secrets
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# CRON_SECRET=your-secure-random-secret-for-cron-auth-here

# VAPID keys for Web Push (server-only)
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_CONTACT=mailto:admin@yourdomain.com
