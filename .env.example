# ============================================================
# VibeForge environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Frontend (Vite) ---------------------------------------------------
# VITE_ prefixed values are embedded in the client bundle and are PUBLIC.
# The anon/publishable key is safe to expose ONLY because RLS is enabled
# on every table. See supabase/migrations/002_rls.sql
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# --- Server-only (Supabase Edge Function secrets) ----------------------
# These MUST NOT use the VITE_ prefix. Vite will inline any VITE_ var into
# the browser bundle, so a secret here would be leaked to every participant.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Authenticates the /process-milestones cron endpoint (Vercel Cron).
CRON_SECRET=your-secure-random-secret-for-cron-auth-here

# Database connection string, used only to apply migrations with psql.
# Supabase dashboard -> Project Settings -> Database -> Connection string.
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres

# --- Web Push (optional, server-only) ---------------------------------
# Only needed if a service worker + Web Push implementation is added.
# Without it, background notifications are NOT possible and must not be claimed.
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_CONTACT=mailto:admin@yourdomain.com
